                on_release: root.confirm()
            Button:
                text: 'CANCEL / EXIT'
                size_hint: (.15, .1)
                halign: 'center'
                pos:(650, 50)
                font_name: "datafiles/fonts/Ubuntu-M.ttf"
                font_size: 24
                background_normal: ''
                background_color: '#c83737ff'
                on_release: root.exit()

