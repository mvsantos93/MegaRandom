#:kivy 2.1.0
#: import FadeTransition kivy.uix.screenmanager.FadeTransition

WindowManager:
    transition: FadeTransition()
    MainScreen:
    DlcScreen:
    AboutScreen:

<MainScreen>
    name: 'main'
    singleclass: singleclass
    multiclass: multiclass
    shortlength: shortlength
    mediumlength: mediumlength
    longlength: longlength
    endurancelength: endurancelength
    raining: raining
    norain: norain
    class1: class1
    class2: class2
    class3: class3
    class4: class4
    class5: class5
    trackname: trackname
    duration: duration
    starttime: starttime
    weather1: weather1
    weather2: weather2
    weather3: weather3
    weather4: weather4
    starttype: starttype
    pitstop: pitstop
    sfcy: sfcy
    fcy: fcy

    FloatLayout:
        Image:
            id: bg
            source: 'datafiles/images/mainbck.png'
            pos:(0,0)
        Label:
            text: 'SETUP'
            pos:(-350, 320)
            font_name: "datafiles/fonts/Ubuntu-M.ttf"
            outline_color: (0.78, 0.22, 0.22, 1)
            outline_width: 3
            font_size: 50
        RelativeLayout:
            pos: (0, 0)
            Label:
                text: 'OPPONENT FIELD TYPE'
                pos:(-490, 270)
                font_name: "datafiles/fonts/Ubuntu-M.ttf"
                outline_color: (0.78, 0.22, 0.22, 1)
                outline_width: 2
                font_size: 24
            Label:
                text: 'Single Class'
                pos:(-515, 235)
                font_name: "datafiles/fonts/Ubuntu-M.ttf"
                font_size: 24
            CheckBox:
                id: singleclass
                group: "opponent field"
                pos: (20, 571)
                size_hint: (None, None)
                size: (30, 25)
                active: True
                background_radio_normal: "datafiles/images/check_empty.png"
                background_radio_down: "datafiles/images/check_marked.png"
            Label:
                text: 'Multi-class'
                pos:(-315, 235)
                font_name: "datafiles/fonts/Ubuntu-M.ttf"
                font_size: 24
            CheckBox:
                id: multiclass
                group: "opponent field"
                pos: (220, 571)
                size_hint: (None, None)
                size: (30, 25)
                background_radio_normal: "datafiles/images/check_empty.png"
                background_radio_down: "datafiles/images/check_marked.png"
        RelativeLayout:
            pos: (0, 0)
            Label:
                text: 'RACE LENGTH'
                pos:(-542, 170)
                font_name: "datafiles/fonts/Ubuntu-M.ttf"
                outline_color: (0.78, 0.22, 0.22, 1)
                outline_width: 2
                font_size: 24
            Label:
                text: 'Short'
                pos:(-550, 135)
                font_name: "datafiles/fonts/Ubuntu-M.ttf"
                font_size: 24
            CheckBox:
                id: shortlength
                group: "race length"
                pos: (20, 471)
                size_hint: (None, None)
                size: (30, 25)
                active: True
                background_radio_normal: "datafiles/images/check_empty.png"
                background_radio_down: "datafiles/images/check_marked.png"
            Label:
